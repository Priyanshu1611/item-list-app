{
  "expo": {
    "name": "price-list-app",
    "slug": "price-list-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "pricelist",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pricelist.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pricelist.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "PriceList",
      "shortName": "PriceList",
      "description": "Manage your shop inventory",
      "themeColor": "#2563EB",
      "backgroundColor": "#ffffff",
      "output": "single-page"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PriceList to save item images to your photo library.",
          "savePhotosPermission": "Allow PriceList to save item images.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
